# Adzuna API credentials (free tier). Sign up at https://developer.adzuna.com/
# After registering an app, copy the App ID and App Key here.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Email delivery (optional). If all three are set, the script emails the
# digest each run instead of/in addition to printing and saving it.
# For Gmail: SMTP_USER is your Gmail address, and SMTP_PASSWORD must be a
# 16-character "app password" (NOT your normal Gmail password) -- generate
# one at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification to be turned on for your Google account).
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
